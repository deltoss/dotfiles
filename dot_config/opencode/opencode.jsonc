{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atlassian": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "todoist": {
      "type": "remote",
      "enabled": true,
      "url": "https://ai.todoist.net/mcp"
    },
    "anki-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@ankimcp/anki-mcp-server", "--stdio"],
      "enabled": true,
      "environment": {
        "ANKI_CONNECT_URL": "http://localhost:8765"
      }
    }
  }
}