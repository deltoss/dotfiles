layout name="👾 Coding" {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane split_direction="vertical" {
        pane size="65%" stacked=true {
          pane {
              name "👾 Editor"
              command "nu"
              args "-e" "if ($env.FILE? | is-not-empty) { y $env.FILE } else { y }"
              expanded true
              focus true
          }
        }
        pane split_direction="horizontal" size="35%" stacked=true {
            pane {
                name "👾 Terminal"
                command "nu"
                start_suspended true
                expanded true
            }
            pane {
                name "🤖 Pi"
                command "pi"
                start_suspended true
            }
            pane {
                name "🤖 OpenCode"
                command "opencode"
                start_suspended true
            }
            pane {
                name "🤖 Claude"
                command "claude"
                args "--allow-dangerously-skip-permissions"
                start_suspended true
            }
            pane {
                name "🌐 HTTP"
                command "nvim"
                args "~/HTTP/"
                start_suspended true
            }
        }
    }
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
}
