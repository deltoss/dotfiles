#!/usr/bin/env nu

def --wrapped main [...args: string] {
  let models_dir = ($env.GUFO_MODELS_DIR? | default ($nu.home-dir | path join "models") | path expand)
  mkdir $models_dir

  let options = [
    "--rm"
    "--userns=keep-id:uid=1000,gid=1000"
    "--device" "/dev/kfd"
    "--device" "/dev/dri"
    "--group-add" "keep-groups"
    "--ulimit" "memlock=-1"
    "-v" $"($models_dir):/models:ro"
  ]

  let tty = if (is-terminal --stdin) and (is-terminal --stdout) { ["-it"] } else { [] }
  let port = if ($args | get -o 0 | default "") == "serve" {
    ["-p" "127.0.0.1:8080:8080"]
  } else {
    []
  }

  exec podman run ...$options ...$tty ...$port ghcr.io/gufo-org/toolboxes/gufo-runtime:latest gufo ...$args
}
