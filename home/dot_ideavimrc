" Reload with :source ~/.ideavimrc, or :source % while editing this file.

" Leader and clipboard setup used by these mappings
nnoremap <Space> <Nop>
vnoremap <Space> <Nop>
let mapleader = " "
set timeoutlen=500
set clipboard=unnamed
set ideawindowjumps
set scrolloff=5
set incsearch
set ignorecase
set smartcase
set ideajoin
set idearefactormode=keep
set ideaoutsideeditor

" Give mapped Ctrl keys to Vim in the modes where they are used.
" Keep Ctrl+C available to Rider in Insert mode.
sethandler <C-z> n-v-i:vim
sethandler <C-y> n-v-i:vim
sethandler <C-r> i-c:vim
sethandler <C-u> n-v:vim
sethandler <C-d> n-v-i:vim
sethandler <C-e> n-v:vim
sethandler <S-Up> n-v-i:vim
sethandler <S-Down> n-v-i:vim
sethandler <C-Up> n:vim
sethandler <C-Down> n:vim
sethandler <C-Left> n-x:vim
sethandler <C-Right> n-x:vim
sethandler <C-s> n-i:vim
sethandler <C-BS> n-i:vim
sethandler <C-Del> n-i:vim
sethandler <C-c> n-v:vim i:ide
sethandler <C-o> n-x:vim
sethandler <C-i> n-x:vim
sethandler <C-k> i:vim
sethandler <C-A-y> n:vim
sethandler <C-A-Left> n:vim
sethandler <C-A-h> n:vim
sethandler <C-A-Down> n:vim
sethandler <C-A-a> n:vim
sethandler <C-A-Up> n:vim
sethandler <C-A-e> n:vim
sethandler <C-A-Right> n:vim
sethandler <C-A-i> n:vim
sethandler <C-P> a:ide

" Undo/redo. Visual mode must exit before running Normal-mode undo/redo.
nnoremap <C-z> u
vnoremap <C-z> <Esc>u
inoremap <C-z> <C-o>u
nnoremap <C-y> <C-r>
vnoremap <C-y> <Esc><C-r>

" Accept the selected Rider completion with Tab-style replacement.
" Without a completion popup, do nothing. Normal/Visual Ctrl+Y stays redo.
imap <C-y> <Action>(EditorChooseLookupItemReplace)

" Paste from the system clipboard
inoremap <C-r><C-r> <C-r>*
inoremap <C-r>r <C-r>*
cnoremap <C-r><C-r> <C-r>*

" Scroll and search, then center the cursor line
nnoremap <C-u> <C-u>zz
vnoremap <C-u> <C-u>zz
nnoremap <C-d> <C-d>zz
vnoremap <C-d> <C-d>zz
nnoremap <C-e> <C-d>zz
vnoremap <C-e> <C-d>zz
nnoremap n nzz
vnoremap n nzz
nnoremap N Nzz
vnoremap N Nzz

" Wrapped display-line navigation with Shift+Up/Down. Plain arrows are unmapped.
nnoremap <S-Up> gk
vnoremap <S-Up> gk
inoremap <S-Up> <C-o>gk
nnoremap <S-Down> gj
vnoremap <S-Down> gj
inoremap <S-Down> <C-o>gj

" Save. Insert Ctrl+S deliberately returns to Normal mode.
nnoremap <C-s> :update<CR>
inoremap <C-s> <Esc>:update<CR>

" Indent/outdent and reselect. Indent width comes from Rider Code Style.
vnoremap < <gv
vnoremap > >gv

" Insert-mode word deletion
inoremap <C-BS> <C-w>
inoremap <C-Del> <C-o>dw
inoremap <C-d> <C-o>dw

" Split editor windows
nnoremap <leader><Up> :split<CR>
nnoremap <leader><Down> :split<CR>
nnoremap <leader><Left> :vsplit<CR>
nnoremap <leader><Right> :vsplit<CR>

" Move focus between splits in Normal mode only
nnoremap <C-Up> <C-w>k
nnoremap <C-Down> <C-w>j
nnoremap <C-Left> <C-w>h
nnoremap <C-Right> <C-w>l

" Delete without replacing copied text
nnoremap <leader>d "_d
vnoremap <leader>d "_d
nnoremap <leader>D "_D
vnoremap <leader>D "_D
nnoremap <leader>x "_x
vnoremap <leader>x "_x
nnoremap <leader>X "_X
vnoremap <leader>X "_X

" Change without replacing copied text
nnoremap <leader>c "_c
vnoremap <leader>c "_c
nnoremap <leader>C "_C
vnoremap <leader>C "_C

" Copy to the end of the line
nnoremap Y y$

" Replace selected text without overwriting the paste register
vnoremap <leader>p "_dP
vnoremap p "_dP

" Join lines
nnoremap <leader>j J

" Change the current word or selection; Ctrl+C is not copy in these modes.
nnoremap <C-c> ciw
vnoremap <C-c> c

" Prepare whole-file substitution of the word under the cursor.
" Type the replacement before pressing Enter.
nnoremap <leader>rw :%s/\<<C-r><C-w>\>//g<Left><Left>

" File paths and IDE navigation history
nmap <leader>yy <Action>(CopyAbsolutePath)
nmap <leader>yp <Action>(CopyAbsolutePath)
nmap <leader>yP <Action>(CopyContentRootPath)

" Word movement, deletion and selection
xmap <C-Right> <Action>(EditorNextWordWithSelection)
xmap <C-Left> <Action>(EditorPreviousWordWithSelection)
nmap <C-BS> <Action>(EditorDeleteToWordStart)
nmap <C-Del> <Action>(EditorDeleteToWordEnd)
xmap v <Action>(EditorSelectWord)
xmap V <Action>(EditorUnSelectWord)

" Files, refactoring, completion and formatting
nmap <leader>sp <Action>(GotoAction)
nmap <leader>a <Action>(NewFile)
nmap <leader>rr <Action>(RenameElement)
nmap <leader>rn <Action>(RenameElement)
nmap <leader>ru <Action>(OptimizeImports)
nmap <leader>r. <Action>(ShowIntentionActions)
xmap <leader>r. <Action>(ShowIntentionActions)
nmap <leader>. <Action>(ShowIntentionActions)
xmap <leader>. <Action>(ShowIntentionActions)
nmap <leader>, <Action>(CodeCompletion)
nmap gc <Action>(CommentByLineComment)
xmap gc <Action>(CommentByLineComment)
nmap gb <Action>(CommentByBlockComment)
xmap gb <Action>(CommentByBlockComment)
nmap <leader>f <Action>(ReformatCode)
xmap <leader>f <Action>(ReformatCode)

" Search, documentation and code navigation
nmap <leader>sc <Action>(SearchEverywhere)
nmap <leader>sg <Action>(FindInPath)
nmap <leader>sf <Action>(GotoFile)
nmap <leader>sr <Action>(RecentFiles)
nmap <leader>sl <Action>(RecentLocations)
nmap <leader>ss <Action>(FileStructurePopup)
nmap <leader>sS <Action>(GotoSymbol)
nmap <leader>sm <Action>(FileStructurePopup)
nmap k <Action>(QuickJavaDoc)
nmap K <Action>(ParameterInfo)
imap <C-k> <Action>(ParameterInfo)
nmap ga <Action>(ShowIntentionActions)
nmap gA <Action>(ReSharperNavigateTo)
nmap gD <Action>(QuickImplementations)
nmap gi <Action>(GotoImplementation)
nmap gr <Action>(ShowUsages)
nmap gR <Action>(FindUsages)
nmap gh <Action>(CallHierarchy)
nmap gt <Action>(GotoClass)
nmap gT <Action>(GotoTypeDeclaration)
nmap zA <Action>(ExpandCollapseToggleAction)
nmap zd <Action>(RiderCollapseToDefinitions)
nmap [[ <Action>(MethodUp)zz
xmap [[ <Action>(MethodUp)zz
nmap ]] <Action>(MethodDown)zz
xmap ]] <Action>(MethodDown)zz

" Errors and bookmarks
nmap <leader>en <Action>(GotoNextError)zz
nmap <leader>ep <Action>(GotoPreviousError)zz
nmap ]e <Action>(GotoNextError)zz
xmap ]e <Action>(GotoNextError)zz
nmap [e <Action>(GotoPreviousError)zz
xmap [e <Action>(GotoPreviousError)zz
nmap <leader>mn <Action>(GotoNextBookmark)zz
nmap <leader>mp <Action>(GotoPreviousBookmark)zz
nmap ]m <Action>(GotoNextBookmark)zz
xmap ]m <Action>(GotoNextBookmark)zz
nmap [m <Action>(GotoPreviousBookmark)zz
xmap [m <Action>(GotoPreviousBookmark)zz
nmap <leader>ma <Action>(ToggleBookmark)<Action>(ActivateBookmarksToolWindow)
nmap <leader>mx <Action>(ToggleBookmark)
nmap <leader>md <Action>(ToggleBookmark)

" Build, debug and tests
nmap _B <Action>(RebuildSelectionAction)
nmap _R <Action>(RebuildSolutionAction)
nmap _C <Action>(CancelBuildAction)
nmap _a <Action>(ToggleLineBreakpoint)
nmap _b <Action>(ViewBreakpoints)
nmap _d <Action>(Debug)
nmap _q <Action>(Stop)
nmap _c <Action>(ActivateDebugToolWindow)
nmap _i <Action>(NavigateToImmediateWindow)
nmap _p <Action>(editRunConfigurations)
nmap _k <Action>(EvaluateExpression)
xmap _k <Action>(EvaluateExpression)
nmap <C-A-y> <Action>(StepOut)
nmap <C-A-Left> <Action>(StepOut)
nmap <C-A-h> <Action>(StepOver)
nmap <C-A-Down> <Action>(StepOver)
nmap <C-A-a> <Action>(Debug)
nmap <C-A-Up> <Action>(Debug)
nmap <C-A-e> <Action>(StepInto)
nmap <C-A-Right> <Action>(StepInto)
nmap <C-A-i> <Action>(RunToCursor)
nmap _ts <Action>(RiderUnitTestRunContextAction)
nmap _tS <Action>(RiderUnitTestDebugContextAction)
nmap _tt <Action>(ActivateUnitTestsToolWindow)

" Tool windows and Solution Explorer search
nmap - <Action>(ActivateProjectToolWindow)
nmap _f <Action>(FindInSolutionView)
nmap <leader>t <Action>(ActivateTerminalToolWindow)
nmap <leader>ee <Action>(ActivateProblemsViewToolWindow)
nmap <leader>mm <Action>(ActivateBookmarksToolWindow)
nmap <leader>T <Action>(ActivateTODOToolWindow)

" Git
nmap <leader>gp <Action>(VcsShowCurrentChangeMarker)
nmap <leader>gP <Action>(Compare.SameVersion)
nmap <leader>gd <Action>(Vcs.Show.Local.Changes)
nmap <leader>gb <Action>(Annotate)
nmap <leader>gh <Action>(Vcs.ShowTabbedFileHistory)
nmap <leader>gH <Action>(Vcs.Show.Log)
nmap <leader>gA <Action>(Refactorings.QuickListPopupAction)
