{{ if hasPrefix "linux" .osid -}}
#!/bin/bash
set -euo pipefail

DIR="$HOME/nerd-fonts"
if [ -d "$DIR/.git" ]; then
  git -C "$DIR" pull --ff-only
else
  git clone --depth 1 https://github.com/ryanoasis/nerd-fonts.git "$DIR"
fi

cd "$DIR"
{{- range .fonts.linux }}
./install.sh install "{{ . }}"
{{- end }}

mkdir -p ~/.local/share/fonts
find "{{ $.chezmoi.workingTree }}/assets/fonts" -mindepth 2 -maxdepth 2 \( -iname '*.ttf' -o -iname '*.otf' \) -exec cp -f {} ~/.local/share/fonts/ \;
fc-cache -f

{{ end -}}
