{{ if hasPrefix "linux" .osid -}}
#!/bin/bash
set -euo pipefail

INSTALLER="$(mktemp)"
trap 'rm -f "$INSTALLER"' EXIT

curl -fsSL https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/install.sh -o "$INSTALLER"
chmod u+x "$INSTALLER"

{{- range .fonts.linux }}
"$INSTALLER" install "{{ . }}"
{{- end }}

mkdir -p ~/.local/share/fonts
find "{{ $.chezmoi.workingTree }}/assets/fonts" -mindepth 2 -maxdepth 2 \( -iname '*.ttf' -o -iname '*.otf' \) -exec cp -f {} ~/.local/share/fonts/ \;
fc-cache -f

{{ end -}}
