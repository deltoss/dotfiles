{{ if hasPrefix "linux" .osid -}}
#!/usr/bin/env nu

# Runs after install-packages (alphabetically later == later execution, see
# chezmoi's application-order docs) so the apps this depends on already exist.
{{- $script := printf "%s/scripts/linux/set_default_apps.nu" .chezmoi.workingTree }}
# Script hash: {{ include $script | sha256sum }}
nu {{ $script | quote }}

{{ end -}}
