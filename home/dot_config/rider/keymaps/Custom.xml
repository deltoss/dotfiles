    <keyboard-shortcut first-keystroke="ctrl q" />
    <keyboard-shortcut first-keystroke="ctrl p" />
  </action>
  <action id="NextTab">
    <keyboard-shortcut first-keystroke="ctrl alt page_down" />
    <keyboard-shortcut first-keystroke="alt h" />
    <keyboard-shortcut first-keystroke="alt o" />
  </action>
  <action id="PreviousTab">
    <keyboard-shortcut first-keystroke="ctrl alt page_up" />
